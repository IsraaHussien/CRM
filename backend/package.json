{
  "name": "azmsquad-customer-service-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js/Express backend (TypeScript) for the AzmSquad customer service platform (auth, tickets, live chat, AI agent, admin).",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo-customer.ts",
    "seed:sla-defaults": "tsx scripts/seed-default-sla-target.ts",
    "seed:demo-full": "tsx scripts/seed-demo-full.ts",
    "seed:import-demo-data": "tsx scripts/import-demo-data.ts",
    "backfill:membership-numbers": "tsx scripts/backfill-membership-numbers.ts",
    "backfill:ticket-numbers": "tsx scripts/backfill-ticket-numbers.ts",
    "backfill:chat-permission": "tsx scripts/backfill-chat-permission.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
